# Variables d'environnement du moteur d'analyse (toutes facultatives).
# Dans l'application installée, ANALYST_PORT / ANALYST_TOKEN / ANALYST_DATA_DIR sont fournis automatiquement,
# et les clés API se saisissent dans Paramètres (stockées dans le Gestionnaire d'identification Windows).
# Les variables ci-dessous servent au développement ou à forcer une valeur.

ANALYST_PORT=8765
# Jeton de session exigé par l'API locale (vide = pas d'authentification, à éviter hors développement)
ANALYST_TOKEN=
# Dossier des données (base SQLite). Par défaut : %APPDATA%\SolanaAIDesktopAnalyst
ANALYST_DATA_DIR=
ANALYST_LOG=warning

# Clés (prioritaires sur le coffre du système si définies)
HELIUS_API_KEY=
LLM_API_KEY=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
